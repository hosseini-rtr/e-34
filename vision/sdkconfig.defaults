CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_CONSOLE_USB_CDC=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Increase main task stack from 3.5KB to 16KB
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Silence the Boya flash chip driver warning
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# Set Brownout Detector to Level 0 (~2.43V instead of default ~2.8V)
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_0=y
CONFIG_ESP_BROWNOUT_DET_LVL=0

# Reduce max Wi-Fi TX power slightly to shave 80-100mA off peak RF spikes
CONFIG_ESP_PHY_MAX_TX_POWER=18